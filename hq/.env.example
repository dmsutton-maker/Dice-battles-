# Copy to .env.local for local work, and paste the same values into
# Vercel's Environment Variables screen for the deployed site.
#
# NOTHING IN HERE GOES IN A COMMIT. This repository is public.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where magic-link emails should send people back to.
# Local: http://localhost:3000   Deployed: https://your-site.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# A long random string of your own invention. Claude sends this to
# /api/queue to read the approved list and to mark work as building or
# shipped. Treat it like a password; change it and the old one stops
# working immediately.
HQ_API_TOKEN=make-up-a-long-random-string

# Supabase → Project Settings → API → service_role.
# Server-side only, never sent to a browser: it lets /api/queue read and
# update ideas without a signed-in person behind the request.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shown on the public support and privacy pages as the contact address.
NEXT_PUBLIC_CONTACT_EMAIL=dmsutton@gmail.com
